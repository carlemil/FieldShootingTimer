default_platform(:ios)
opt_out_usage

# Fastlane auto-loads iosApp/fastlane/.env (gitignored). Keep
# ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH there.

APP_ID = "se.kjellstrand.fieldshootingtimer"

platform :ios do

  # Every archive uses `git rev-list --count HEAD` as the build number so
  # uploads never collide. Stored on @build_number to share across lanes
  # within one fastlane run.
  before_all do
    @build_number = `git rev-list --count HEAD`.strip
    UI.message("Using build number #{@build_number}")
  end

  desc "Regenerate Xcode project from project.yml (idempotent)."
  lane :gen do
    sh("cd .. && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodegen generate")
  end

  # Build the ASC API key, fetch (or create) an Apple Distribution cert and
  # an App Store provisioning profile for APP_ID, then archive via gym.
  # Returns the resolved profile name so the caller can decide what to upload.
  private_lane :archive_for_app_store do
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house:     false,
    )

    # Creates an Apple Distribution cert + installs it in the login keychain
    # if one doesn't exist. Skips if a valid cert is already present. Default
    # is iOS distribution (development: false); no other params needed.
    get_certificates(
      api_key: api_key,
    )

    # Creates an App Store distribution profile for APP_ID if missing,
    # downloads it locally, installs it. Defaults (adhoc=false,
    # development=false) already mean App Store; setting both explicitly
    # trips a conflict check, so let them default.
    get_provisioning_profile(
      api_key:        api_key,
      app_identifier: APP_ID,
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    build_app(
      xcargs: %(CURRENT_PROJECT_VERSION=#{@build_number} PROVISIONING_PROFILE_SPECIFIER="#{profile_name}"),
      export_options: {
        method:         "app-store",
        signingStyle:   "manual",
        teamID:         ENV.fetch("FASTLANE_TEAM_ID"),
        uploadBitcode:  false,
        uploadSymbols:  true,
        provisioningProfiles: { APP_ID => profile_name },
      },
    )

    api_key
  end

  desc "Build a signed App Store archive and upload to TestFlight."
  lane :beta do
    gen
    api_key = archive_for_app_store
    upload_to_testflight(
      api_key:                            api_key,
      skip_waiting_for_build_processing:  true,
      changelog:                          File.read("metadata/sv/release_notes.txt").strip,
    )
  end

  desc "Build a signed App Store archive and submit to the App Store (not for review). " \
       "Screenshots are left to the metadata lane — run it after this one."
  lane :release do
    gen
    api_key = archive_for_app_store
    upload_to_app_store(
      api_key:           api_key,
      # The metadata lane owns the screenshots. Uploading them from here too
      # only ever made a mess: without overwrite_screenshots this lane hit the
      # 10-per-device cap and silently skipped every retake ("Too many
      # screenshots found for device ..."), while still logging "Successfully
      # uploaded all screenshots".
      skip_screenshots:  true,
      skip_metadata:     false,
      submit_for_review: false,
    )
  end

  desc "Attach an already-uploaded, processed build to the App Store version " \
       "(API only: no binary upload, no metadata, not submitted for review)."
  lane :select_build do
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house:     false,
    )
    plist = File.expand_path("../iosApp/Info.plist", __dir__)
    app_version = `/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "#{plist}"`.strip
    UI.message("Selecting build #{@build_number} for App Store version #{app_version}")
    upload_to_app_store(
      api_key:            api_key,
      app_version:        app_version,
      build_number:       @build_number,
      skip_binary_upload: true,
      skip_screenshots:   true,
      skip_metadata:      true,
      submit_for_review:  false,
      force:              true,
    )
  end

  # NOTE: deliver's screenshot upload is not reliable on its own. It uploads
  # the whole set, then re-reads it to confirm; ASC has not indexed the new
  # assets yet, so deliver reports "<file> is missing on App Store Connect",
  # fails the batch ("Tries remaining: 4") and re-uploads the first few — which
  # lands as DUPLICATES even with overwrite_screenshots. Seen twice in a row on
  # 1.11.0, always the same shape: the first four of each set doubled, filling
  # it back to the 10 cap. Always verify the sets afterwards and delete the
  # duplicates (keep one per file name) rather than re-running this lane; a
  # re-run reproduces the duplicates instead of clearing them.
  desc "Push App Store metadata (text + screenshots) without uploading a binary."
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house:     false,
    )
    upload_to_app_store(
      api_key:               api_key,
      skip_binary_upload:    true,
      skip_screenshots:      false,
      skip_metadata:         false,
      submit_for_review:     false,
      # Replace the ASC screenshot set instead of appending to it — without
      # this, retaken screenshots hit the 10-per-device cap and are skipped.
      overwrite_screenshots: true,
    )
  end
end
